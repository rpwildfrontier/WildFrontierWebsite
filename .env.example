# ─────────────────────────────────────────────────────────────
# Wild Frontier RP — Variables d'environnement
# Copiez ce fichier en .env.local et remplissez les valeurs.
# Ne commitez JAMAIS .env.local
# ─────────────────────────────────────────────────────────────

# ── NextAuth ─────────────────────────────────────────────────
# Générer : openssl rand -base64 32
NEXTAUTH_SECRET=

# En développement : http://localhost:3000
# En production : https://votre-domaine.com
NEXTAUTH_URL=https://votre-domaine.com

# ── Discord OAuth (Application Discord Developer Portal) ─────
# https://discord.com/developers/applications
# Redirect URI à configurer : NEXTAUTH_URL/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── Discord Webhooks (pour les formulaires) ──────────────────
# Créez des webhooks dans vos canaux Discord (#contact, #candidatures)
DISCORD_WEBHOOK_CONTACT=
DISCORD_WEBHOOK_CANDIDATURES=

# ── Staff (IDs Discord séparés par virgule) ──────────────────
# Trouvez votre ID Discord : Paramètres > Avancé > Mode développeur
# puis clic droit sur votre pseudo
STAFF_DISCORD_IDS=
