# ─────────────────────────────────────────────────────────────
# Wild Frontier RP — Variables d'environnement
# Copiez ce fichier en .env.local et remplissez les valeurs.
# Ne commitez JAMAIS .env.local
# ─────────────────────────────────────────────────────────────

# ── NextAuth ─────────────────────────────────────────────────
# Générer : openssl rand -base64 32
NEXTAUTH_SECRET=

# En développement : http://localhost:3000
# En production    : https://votre-domaine.vercel.app
NEXTAUTH_URL=https://votre-domaine.vercel.app

# ── Discord OAuth (Application Discord Developer Portal) ─────
# https://discord.com/developers/applications
# Redirect URI à configurer : NEXTAUTH_URL/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── Discord Bot ───────────────────────────────────────────────
# Créez un bot sur le Developer Portal → Bot → Reset Token
# Ajoutez le bot à votre serveur avec les permissions : Read Members
DISCORD_BOT_TOKEN=

# ── Serveur Discord ───────────────────────────────────────────
# ID du serveur Discord (clic droit sur le serveur → Copier l'ID)
DISCORD_GUILD_ID=

# ID du rôle "Joueur validé" (clic droit sur le rôle → Copier l'ID)
DISCORD_ROLE_JOUEUR=

# ID du rôle "Staff" (clic droit sur le rôle → Copier l'ID)
DISCORD_ROLE_STAFF=

# ── Discord Webhooks (formulaires → canaux privés staff) ──────
# Créez des webhooks dans vos canaux Discord (canal privé staff uniquement)
# Canal → Paramètres → Intégrations → Webhooks → Nouveau webhook
DISCORD_WEBHOOK_CONTACT=
DISCORD_WEBHOOK_CANDIDATURES=

# ── Fallback staff (si pas de bot configuré) ─────────────────
# IDs Discord des membres staff, séparés par virgule
# Mode développeur Discord : Paramètres → Avancé → Mode développeur
# puis clic droit sur un pseudo → Copier l'identifiant
STAFF_DISCORD_IDS=

# ── Steam Web API ─────────────────────────────────────────────
# https://steamcommunity.com/dev/apikey
# Utilisé pour récupérer le nom, l'avatar et vérifier RDR2 (appid 1174180)
STEAM_API_KEY=

# ── CFX.re (forum.cfx.re Discourse User API Key) ─────────────
# Pas de registration — générez vos propres clés RSA (voir README)
# Client ID : une chaîne unique quelconque (UUID recommandé)
CFX_CLIENT_ID=
# Nom de l'application affiché sur forum.cfx.re lors de la liaison
CFX_APP_NAME=Wild Frontier RP
# Clé publique RSA (PEM, \n remplacés par \\n pour env var)
CFX_RSA_PUBLIC_KEY=
# Clé privée RSA (PEM, \n remplacés par \\n pour env var)
CFX_RSA_PRIVATE_KEY=

# ── Espace Staff (accès basé sur les pseudos CFX.re) ─────────
# Pseudos forum.cfx.re autorisés, séparés par virgule
STAFF_CFX_USERNAMES=
